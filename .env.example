# DataPilot AI Pro
# ── Infrastructure ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://datapilot:datapilot123@localhost:5432/datapilot
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333

# ── LLM (primary: local Ollama, NO API key required) ─────────────────────────
# Pull the model once:  ollama pull mistral:7b-instruct
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:7b-instruct

# ── Optional cloud fallbacks (legacy — leave blank for fully local setup) ────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── ML settings ──────────────────────────────────────────────────────────────
CV_FOLDS=5
MAX_UPLOAD_SIZE_MB=100
PPO_MODEL_PATH=./rl_selector/models
UPLOAD_DIR=./uploads

# ── RAG (all local models — no API keys) ─────────────────────────────────────
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_COLLECTION=datapilot_knowledge
