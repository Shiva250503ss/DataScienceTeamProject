.streamlit/secrets.toml
.env

# Python bytecode cache — regenerated automatically on import
__pycache__/
*.py[cod]
*.pyo

# Jupyter
.ipynb_checkpoints/

# Local databases — regenerated on each run (see db/session.py's SQLite
# fallback and PROJECT_STATUS.md for the tracked MLflow experiment)
datapilot.db
mlflow.db
mlruns/

# Fine-tuning artifacts — adapters, merged models, GGUF exports. Large
# binaries, never meant to be committed (see finetuning/README.md).
finetuning/models/

# Vendored build tooling — cloned locally to build llama-quantize for GGUF
# export (see finetuning/export_ollama.py). Never meant to be committed.
llama.cpp/

# RAG embedded vector index — rebuildable local cache. documents.json,
# knowledge_graph.json, and retrieval_eval_results.md alongside it are
# NOT ignored: those are real measured results, not cache.
rag_store/qdrant_local/

# Runtime data — uploaded datasets, service logs, pipeline outputs. All
# regenerated by running the app; not source.
uploads/
logs/
output/
